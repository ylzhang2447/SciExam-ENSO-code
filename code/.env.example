# Credentials for `sciexam run-agent`. Copy to .env and fill in only what your arm needs.
# Values are read from the environment first, then from this file. They are passed to
# containers as `docker ... -e NAME` and are never printed or written to the run records.
# Each rerun uses your own account and is billed or counted against it.

# Gateway arms (kimi, glm52, qwen3max, deepseek, minimax, dsflash): OpenRouter API key.
OPENROUTER_API_KEY=
# Optional key of the local LiteLLM gateway. A random one is generated per run when empty.
LITELLM_MASTER_KEY=

# Claude subscription arms (opus5, fable51 and its condition runs): long-lived token printed by
# `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Codex arms (gpt56, gpt55, gpt6astra): path to the auth.json that `codex login` writes after
# the ChatGPT sign-in (usually ~/.codex/auth.json). It is copied into the run's CODEX_HOME.
CODEX_AUTH_JSON=

# Antigravity arm (gemini38): path to the .gemini folder the Antigravity CLI writes after the
# Google sign-in, and the URL of the official Antigravity CLI binary for Linux x64 (version
# 1.2.0, its sha256 is pinned in agents/gemini38.yaml and checked at build time).
ANTIGRAVITY_HOME=
ANTIGRAVITY_URL=

# Time zone in which a provider states a wall-clock quota reset ("try again at 1:10 AM") when
# the message names none. Default UTC.
SCIEXAM_PROVIDER_TZ=
